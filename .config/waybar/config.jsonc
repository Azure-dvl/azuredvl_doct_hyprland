{
  "layer": "top",
  "position": "top",
  "height": 34,
  "width": 700,
  "spacing": 0,
  "margin": "0 0",

  "modules-left": [
    "custom/android-studio",
    "custom/vscode",
    "custom/obs",
    "custom/thunderbird",
    "custom/telegram",
    "custom/discord",
    "custom/lutris",
  ],

  "modules-center": ["clock"],

  "modules-right": ["tray", "pulseaudio", "bluetooth", "cpu", "memory"],

  "pulseaudio": {
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-icons": ["  ", "   ", "   "],
    "format-muted": "   ",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "hyprpwcenter",
    "tooltip": true,
    "tooltip-format": "{volume}% | {desc}",
  },

  "cpu": {
    "interval": 1,
    "format": " <span font='Font Awesome 6 Free-Solid'></span>  {usage}%",
    "on-click": "kitty btop",
  },

  "memory": {
    "interval": 1,
    "format": " <span font='Font Awesome 6 Free'></span>  {percentage}%",
    "on-click": "kitty btop",
    "tooltip-format": "{used}/{total} GiB",
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager",
  },

  "tray": {
    "icon-size": 12,
    "spacing": 12,
  },

  "custom/android-studio": {
    "format": "  ",
    "tooltip-format": "Android Studio",
    "on-click": "/usr/bin/android-studio",
  },

  "custom/vscode": {
    "format": "  ",
    "tooltip-format": "Visual Studio Code",
    "on-click": "/usr/bin/code",
  },

  "custom/obs": {
    "format": "  ",
    "tooltip-format": "OBS Studio",
    "on-click": "/usr/bin/obs",
  },

  "custom/telegram": {
    "format": "  ",
    "tooltip-format": "Telegram",
    "on-click": "/usr/bin/Telegram",
  },

  "custom/thunderbird": {
    "format": "  ",
    "tooltip-format": "Thunderbird",
    "on-click": "/usr/bin/thunderbird",
  },

  "custom/lutris": {
    "format": "  ",
    "tooltip-format": "Lutris",
    "on-click": "/usr/bin/lutris",
  },

  "custom/discord": {
    "format": " 󰍦 ",
    "tooltip-format": "Discord",
    "on-click": "gtk-launch discord-460807638964371468.desktop",
  },
  "clock": {
    "tooltip-format": "{calendar}",
    "format-alt": "  {:%a, %d %b %Y}",
    "format": "  {:%I:%M %p}",
  },
}
